<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <Button
        android:id="@+id/btn_write_flash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="写入Mcu Flash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/edt_flash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:hint="输入16进制数"
        app:layout_constraintStart_toEndOf="@id/btn_write_flash"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_read_flash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="读取Mcu Flash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_write_flash" />

    <TextView
        android:id="@+id/tv_mcu_flash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constraintBaseline_toBaselineOf="@id/btn_read_flash"
        app:layout_constraintStart_toEndOf="@id/btn_read_flash"
        app:layout_constraintTop_toBottomOf="@id/edt_flash" />

    <Button
        android:id="@+id/btn_read_power_on_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="读取开机时间"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_read_flash" />

    <TextView
        android:id="@+id/tv_power_on_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/power_on_time"
        app:layout_constraintBaseline_toBaselineOf="@id/btn_read_power_on_time"
        app:layout_constraintStart_toEndOf="@id/btn_read_power_on_time"
        app:layout_constraintTop_toBottomOf="@id/edt_flash" />

    <Button
        android:id="@+id/btn_read_power_on_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="读取开机状态"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_read_power_on_time" />

    <TextView
        android:id="@+id/tv_power_on_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/power_on_status"
        app:layout_constraintBaseline_toBaselineOf="@id/btn_read_power_on_status"
        app:layout_constraintStart_toEndOf="@id/btn_read_power_on_status"
        app:layout_constraintTop_toBottomOf="@id/edt_flash" />

    <Button
        android:id="@+id/btn_write_power_on_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置开机时间"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_read_power_on_status" />

    <EditText
        android:id="@+id/edt_power_on_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="2024-08-09 17:52:30"
        android:hint="yyyy-mm-dd hh:MM:ss"
        app:layout_constraintBaseline_toBaselineOf="@id/btn_write_power_on_time"
        app:layout_constraintStart_toEndOf="@id/btn_write_power_on_time"
        app:layout_constraintTop_toBottomOf="@id/edt_flash" />

    <Switch
        android:id="@+id/sw_power_on_off"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="开关"
        android:checked="true"
        app:layout_constraintBaseline_toBaselineOf="@id/edt_power_on_time"
        app:layout_constraintStart_toEndOf="@id/edt_power_on_time"
        app:layout_constraintTop_toBottomOf="@id/edt_flash" />

    <Button
        android:id="@+id/btn_read_watch_dog_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="读取看门狗状态"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_write_power_on_time" />

    <TextView
        android:id="@+id/tv_watch_dog_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/watch_dog_status"
        app:layout_constraintBaseline_toBaselineOf="@id/btn_read_watch_dog_status"
        app:layout_constraintStart_toEndOf="@id/btn_read_watch_dog_status"
        app:layout_constraintTop_toBottomOf="@id/edt_flash" />

    <Button
        android:id="@+id/btn_write_watch_dog_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置喂门狗时间"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_read_watch_dog_status" />

    <EditText
        android:id="@+id/edt_write_watch_dog_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:inputType="number"
        android:hint="5-180秒"
        app:layout_constraintBaseline_toBaselineOf="@id/btn_write_watch_dog_time"
        app:layout_constraintStart_toEndOf="@id/btn_write_watch_dog_time"
        app:layout_constraintTop_toBottomOf="@id/edt_flash" />

    <TextView
        android:id="@+id/tv_feed_watch_dog_time_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="秒"
        app:layout_constraintBaseline_toBaselineOf="@id/edt_write_watch_dog_time"
        app:layout_constraintStart_toEndOf="@id/edt_write_watch_dog_time"
        app:layout_constraintTop_toBottomOf="@id/edt_flash" />

    <Switch
        android:id="@+id/sw_feed_watch_dog_time_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="开关"
        android:checked="true"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_feed_watch_dog_time_unit"
        app:layout_constraintStart_toEndOf="@id/tv_feed_watch_dog_time_unit"
        app:layout_constraintTop_toBottomOf="@id/edt_flash" />


    <Button
        android:id="@+id/btn_feed_watch_dog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="喂看门狗"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_write_watch_dog_time" />

    <TextView
        android:id="@+id/tv_feed_watch_dog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/feed_watch_dog_status"
        app:layout_constraintBaseline_toBaselineOf="@id/btn_feed_watch_dog"
        app:layout_constraintStart_toEndOf="@id/btn_feed_watch_dog"
        app:layout_constraintTop_toBottomOf="@id/edt_flash" />

    <Button
        android:id="@+id/btn_read_mcu_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="读取mcu版本"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_feed_watch_dog" />

    <TextView
        android:id="@+id/tv_read_mcu_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/mcu_version"
        app:layout_constraintBaseline_toBaselineOf="@id/btn_read_mcu_version"
        app:layout_constraintStart_toEndOf="@id/btn_read_mcu_version"
        app:layout_constraintTop_toBottomOf="@id/edt_flash" />


</androidx.constraintlayout.widget.ConstraintLayout>