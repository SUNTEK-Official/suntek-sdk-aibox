<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="180.0dip"
    android:layout_height="fill_parent"
    android:layout_gravity="center">

    <EditText
        android:id="@+id/close_sys_data"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:hint="@string/close_sys_data" />

    <EditText
        android:id="@+id/close_sys_time"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:hint="@string/close_sys_time"
        app:layout_constraintTop_toBottomOf="@+id/close_sys_data" />

    <EditText
        android:id="@+id/open_sys_data"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:hint="@string/open_sys_data"
        app:layout_constraintTop_toBottomOf="@+id/close_sys_time" />

    <EditText
        android:id="@+id/open_sys_time"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:hint="@string/open_sys_time"
        app:layout_constraintTop_toBottomOf="@+id/open_sys_data" />

    <Button
        android:id="@+id/reboot_sys"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_scheduled_power_on_and_off"
        android:background="@drawable/btn_selector"
        android:text="重启系统"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/open_sys_time" />

    <Button
        android:id="@+id/shutdown_sys"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_scheduled_power_on_and_off"
        android:background="@drawable/btn_selector"
        android:text="关机"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/reboot_sys" />

    <Button
        android:id="@+id/set_close"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_scheduled_power_on_and_off"
        android:background="@drawable/btn_selector"
        android:text="设置关机"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/shutdown_sys" />

    <Button
        android:id="@+id/set_open"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_scheduled_power_on_and_off"
        android:background="@drawable/btn_selector"
        android:text="设置开机"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/set_close" />

    <Button
        android:id="@+id/cancel_close"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_scheduled_power_on_and_off"
        android:background="@drawable/btn_selector"
        android:text="清除关机"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/set_open" />

    <Button
        android:id="@+id/cancel_open"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_scheduled_power_on_and_off"
        android:background="@drawable/btn_selector"
        android:text="清除开机"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/cancel_close" />

    <Button
        android:id="@+id/cancel_open_close"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_scheduled_power_on_and_off"
        android:background="@drawable/btn_selector"
        android:padding="@dimen/activity_main_padding"
        android:text="清除开关机"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/cancel_open" />

    <Button
        android:id="@+id/sure"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_scheduled_power_on_and_off"
        android:background="@drawable/btn_selector"
        android:padding="@dimen/activity_main_padding"
        android:text="确认"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/cancel_open_close" />
</androidx.constraintlayout.widget.ConstraintLayout>