<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/rotation"
            android:layout_width="@dimen/activity_main_layout_width"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/activity_main_layout_margin"
            android:layout_marginBottom="10.0dip"
            android:background="@drawable/btn_selector"
            android:padding="@dimen/activity_main_padding"
            android:text="单击旋转90度"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/bt_open"
            android:layout_width="@dimen/activity_main_layout_width"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/activity_main_layout_margin"
            android:background="@drawable/btn_selector"
            android:padding="@dimen/activity_main_padding"
            android:text="获取屏幕方向"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@+id/rotation" />
    </LinearLayout>
</LinearLayout>